# Piloncillo — PINs de acceso por sección y unidad
# Copia este archivo como .env.local y pon los valores reales
# NUNCA commitees .env.local al repositorio

PILONCILLO_PIN_DIRECCION=
PILONCILLO_PIN_ADMINISTRACION=
PILONCILLO_PIN_RRHH=

# Gerencias — una por unidad
PILONCILLO_PIN_LA_CRUZ=
PILONCILLO_PIN_OAXACA_MANANA=
PILONCILLO_PIN_OAXACA_VESPERTINO=
PILONCILLO_PIN_IXTLAN_DEL_RIO=
PILONCILLO_PIN_PANADERIA=

# Anthropic
ANTHROPIC_API_KEY=

# Vercel KV
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── KAII Panel Maestro (Saúl) ────────────────────────────────────────────────
KAII_MASTER_PIN=

# ─── Cron semanal + Email ─────────────────────────────────────────────────────
# CRON_SECRET lo asigna Vercel automáticamente; cópialo también para pruebas manuales
CRON_SECRET=
# Resend.com — obtén tu API key en resend.com/api-keys (plan gratis disponible)
RESEND_API_KEY=
# Remitente (requiere dominio verificado en Resend; usa onboarding@resend.dev para pruebas)
EMAIL_FROM=KAII <onboarding@resend.dev>
# Destinatario del resumen semanal
REPORT_EMAIL=saul@kaiiconsultores.com

# ─── WhatsApp (Twilio) ────────────────────────────────────────────────────────
# Obtén en twilio.com/console (plan gratis disponible para pruebas)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio WhatsApp (sandbox gratis: +14155238886, producción: tu número aprobado)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Número destino con código de país: +521XXXXXXXXXX (México)
WHATSAPP_TO=+521XXXXXXXXXX
